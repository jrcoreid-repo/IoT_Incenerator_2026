# ADI Smart Incinerator: contoh variabel, jangan isi rahasia di GitHub.
# Copy ke .env.local (atau konfigurasi environment unit service VPS).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
TELEMETRY_INGEST_KEY=

# Pilih SALAH SATU backend Redis untuk produksi:
# Opsi VPS dengan Redis TCP lokal (bind hanya ke 127.0.0.1):
REDIS_URL=

# ATAU Redis REST terkelola (Upstash), bukan keduanya:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Development lokal tanpa Redis menggunakan penyimpanan lokal.
# NODE_ENV=production mewajibkan Redis; jangan deploy tanpa database persisten.
# Jangan mengubah token/SESSION_SECRET VPS saat revisi kode tanpa rencana rotasi.
